# ==========================================================
# KONFIGURASI MEETRESULT
# Salin file ini menjadi ".env" lalu isi sesuai kredensial kamu
# ==========================================================

# --- Mode Kalender ---
# "ics"   (default, PALING MUDAH): cukup URL publish kalender dari Outlook Web,
#          tanpa perlu bikin Azure App / login OAuth. Lihat README "Setup Kalender (ICS)".
# "graph" : pakai Microsoft Graph API (butuh Azure App Registration + `meetresult login`),
#          lebih real-time & datanya lebih lengkap (joinUrl pasti akurat).
CALENDAR_MODE=ics

# --- Mode ICS (dipakai jika CALENDAR_MODE=ics) ---
# Dapatkan dari: Outlook Web > Settings > Calendar > Shared calendars
#   > Publish a calendar > pilih "Can view all details" > copy link "ICS"
CALENDAR_ICS_URL=

# --- Mode Graph / Microsoft Azure AD App (dipakai jika CALENDAR_MODE=graph) ---
# Buat di https://portal.azure.com > Azure Active Directory > App registrations
# Redirect: gunakan "Device Code Flow", tidak butuh redirect URI web
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# --- Provider AI untuk membuat notulen (teks transkrip -> JSON MoM) ---
# "claude" (DEFAULT): pakai Claude, lihat konfigurasi CLAUDE_* di bawah.
# "openai": pakai endpoint Chat Completions OpenAI-compatible (OPENAI_*) - bisa OpenAI cloud
#   ATAU server LOKAL (oMLX/Ollama/LM Studio) via OPENAI_BASE_URL. Kalau `npm install` mendeteksi
#   salah satu server lokal tersebut aktif, baris ini otomatis di-set ke "openai" - jalankan
#   `meetresult setup-ai` kapan saja untuk deteksi ulang manual.
# "agy": pakai Antigravity CLI, lihat AGY_* di bawah.
# "opencode": pakai OpenCode CLI, lihat OPENCODE_* di bawah - NOTULEN SAJA, tidak untuk transkripsi.
# "ninerouter": pakai gateway 9Router (https://github.com/decolua/9router, lokal/remote,
#   OpenAI-compatible) lewat /v1/chat/completions - lihat NINEROUTER_* di bawah.
SUMMARY_PROVIDER=claude
# Provider BACKUP kalau provider utama di atas gagal (error teknis, kuota habis, dll) -
# kosongkan untuk nonaktifkan. Isi salah satu: claude / openai / agy / opencode / ninerouter
# (beda dari provider utama).
SUMMARY_FALLBACK_PROVIDER=

# --- Claude (dipakai jika SUMMARY_PROVIDER=claude) ---
# Mode "cli" (DEFAULT, direkomendasikan): pakai Claude Code CLI yang sudah login
#   dengan akun/subscription kamu (`claude login`), TANPA API key terpisah.
# Mode "api": pakai Anthropic API langsung, butuh ANTHROPIC_API_KEY (dikenakan biaya per token).
CLAUDE_MODE=cli
CLAUDE_CLI_BIN=claude
# Opsional: paksa model tertentu di Claude Code CLI (kosongkan untuk pakai default)
CLAUDE_CLI_MODEL=

# --- (Hanya jika CLAUDE_MODE=api) Anthropic API key ---
# Dapatkan di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI-compatible (dipakai jika SUMMARY_PROVIDER=openai) ---
# OPENAI_BASE_URL: default OpenAI cloud. Untuk pakai model LOKAL, arahkan ke server lokal
#   yang OpenAI-compatible, misalnya:
#   oMLX (Apple Silicon): http://127.0.0.1:8000/v1  (port & API key ada di ~/.omlx/settings.json)
#   Ollama              : http://localhost:11434/v1
#   LM Studio           : http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Kosongkan kalau server lokal tidak butuh autentikasi (umum untuk Ollama/LM Studio; oMLX WAJIB isi)
OPENAI_API_KEY=
# Isi nama model sesuai provider/server yang dipakai
OPENAI_MODEL=gpt-4o-mini

# --- Antigravity CLI / Gemini (dipakai jika SUMMARY_PROVIDER=agy) ---
# Pakai Antigravity CLI (Google, akses model Gemini) yang sudah terinstall & login di mesin
# ini - https://antigravity.google - TANPA API key terpisah. Sama seperti CLAUDE_MODE=cli,
# ini shell-out ke binary resmi yang sudah kamu install & login sendiri.
AGY_CLI_BIN=agy
# Kosongkan untuk pakai model default sesi agy yang sedang login. Cek pilihan model dengan
# `agy models` di terminal (atau `meetresult models` setelah SUMMARY_PROVIDER=agy).
AGY_MODEL=

# --- OpenCode CLI (dipakai jika SUMMARY_PROVIDER=opencode) - NOTULEN SAJA, bukan transkripsi ---
# Pakai OpenCode CLI (https://opencode.ai) yang sudah terinstall & login sendiri di mesin ini
# ('opencode providers login') - akses banyak model (Claude/GPT/Gemini/dll) lewat OpenCode
# Zen/Go. SENGAJA cuma dipakai untuk notulen (teks) - attachment audio di CLI opencode belum
# berfungsi, dan begitu gagal, model mencoba menjalankan perintah shell sendiri untuk mencari
# cara lain (perilaku agentic yang tidak aman untuk transkripsi otomatis).
OPENCODE_CLI_BIN=opencode
# Format WAJIB "provider/model", mis. "opencode/gemini-3.7-flash" atau "opencode-go/kimi-k3" -
# cek pilihan dengan `opencode models` di terminal. Kosongkan untuk pakai default opencode.
OPENCODE_MODEL=

# --- 9Router untuk NOTULEN (dipakai jika SUMMARY_PROVIDER=ninerouter) ---
# https://github.com/decolua/9router - gateway OpenAI-compatible lokal/remote untuk banyak
# provider AI sekaligus (satu key, banyak provider, auto-fallback). SENGAJA TERPISAH dari
# NINEROUTER_TRANSCRIBE_* di bawah (dipakai TRANSCRIBE_PROVIDER=ninerouter) walau sama-sama
# 9Router - 9Router sendiri punya daftar model TERPISAH untuk chat (/v1/models) vs
# speech-to-text (/v1/models/stt), jadi kedua peran ini dipisah total di sini juga.
NINEROUTER_URL=
# Boleh kosong kalau instance 9Router-nya tidak mengaktifkan requireApiKey.
NINEROUTER_API_KEY=
# Format WAJIB "provider/model", mis. "openai/gpt-5" atau "cc/claude-opus-4-7" - cek pilihan
# lewat GET <NINEROUTER_URL>/v1/models.
NINEROUTER_MODEL=

# --- Provider transkripsi audio->teks ---
# "whisper" (DEFAULT): lokal, offline, gratis - lihat konfigurasi WHISPER_* di bawah. Model
#   diunduh otomatis saat pertama kali dipakai (atau lewat tombol "Unduh" di menu tray).
# "gemini": kirim audio ke Gemini API (butuh internet + GEMINI_API_KEY) - Gemini bisa native
#   paham audio langsung, TERBUKTI paling akurat untuk istilah/nama khusus (lihat SETUP.md
#   bagian Performa), tapi audio meeting kamu terkirim ke server Google.
# "openai": kirim audio ke OpenAI Audio Transcriptions API RESMI (butuh internet +
#   OPENAI_TRANSCRIBE_API_KEY) - audio meeting kamu terkirim ke server OpenAI.
# "openai-compatible": server CUSTOM/LOKAL milik sendiri yang kompatibel dengan bentuk API
#   OpenAI Audio Transcriptions (POST /audio/transcriptions) - TERPISAH dari "openai" di atas
#   supaya konfigurasinya tidak tertukar. Lihat OPENAI_COMPATIBLE_TRANSCRIBE_* di bawah.
# "ninerouter": pakai gateway 9Router lewat /v1/audio/transcriptions - model WAJIB dari daftar
#   KHUSUS speech-to-text /v1/models/stt (BUKAN daftar model chat biasa). Lihat
#   NINEROUTER_TRANSCRIBE_* di bawah - TERPISAH dari NINEROUTER_* untuk notulen di atas.
TRANSCRIBE_PROVIDER=whisper
# Provider BACKUP kalau provider utama di atas gagal (error teknis, kuota habis, dll) -
# kosongkan untuk nonaktifkan. Rekomendasi: isi "whisper" kalau provider utama cloud (gemini/
# openai), supaya transkripsi TETAP berhasil walau cloud down/kuota habis.
TRANSCRIBE_FALLBACK_PROVIDER=

# --- Gemini API (dipakai jika TRANSCRIBE_PROVIDER=gemini) ---
# Dapatkan API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# WAJIB diisi manual - cek nama model audio-capable TERBARU di Google AI Studio
# (nama model Gemini berubah dari waktu ke waktu, sengaja tidak di-hardcode default-nya)
GEMINI_MODEL=
# Gemini punya limit request/menit (beberapa tier free/paid dibatasi 15 req/menit) - kalau
# transkripsi kena limit, coba lagi setelah jeda ini (bukan retry beruntun agresif) sebelum
# benar-benar menyerah ke TRANSCRIBE_FALLBACK_PROVIDER.
GEMINI_TRANSCRIBE_MAX_RETRIES=3
GEMINI_TRANSCRIBE_RETRY_DELAY_MS=60000

# --- OpenAI Audio Transcriptions RESMI (dipakai jika TRANSCRIBE_PROVIDER=openai) ---
# SENGAJA terpisah dari OPENAI_API_KEY/OPENAI_BASE_URL di atas (yang dipakai untuk NOTULEN
# lewat SUMMARY_PROVIDER=openai) - base URL notulen sering diarahkan ke server LOKAL (oMLX/
# Ollama/LM Studio) yang umumnya tidak punya endpoint audio, sedangkan transkripsi audio
# hampir selalu butuh OpenAI cloud asli. Dapatkan API key di https://platform.openai.com/api-keys
OPENAI_TRANSCRIBE_API_KEY=
# Kosongkan untuk pakai server OpenAI cloud asli (default) - jarang perlu diubah
OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# "gpt-4o-transcribe" (DEFAULT, akurasi lebih baik) / "gpt-4o-mini-transcribe" (lebih cepat &
# murah) / "whisper-1" (model lama OpenAI, lebih murah)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Custom OpenAI-compatible (dipakai jika TRANSCRIBE_PROVIDER=openai-compatible) ---
# TERPISAH dari OPENAI_TRANSCRIBE_* di atas (OpenAI cloud RESMI) - untuk server transkripsi
# CUSTOM/LOKAL milik sendiri yang cuma KOMPATIBEL dengan bentuk API-nya (POST
# /audio/transcriptions), supaya konfigurasi keduanya tidak tertukar/ke-mix. Tidak ada
# default base URL - WAJIB diisi manual, mis. http://localhost:8000/v1
OPENAI_COMPATIBLE_TRANSCRIBE_BASE_URL=
# Boleh kosong kalau server custom tidak butuh autentikasi.
OPENAI_COMPATIBLE_TRANSCRIBE_API_KEY=
# Isi ID model sesuai yang disediakan server custom-mu (boleh kosong kalau server hanya
# punya 1 model dan mengabaikan parameter ini).
OPENAI_COMPATIBLE_TRANSCRIBE_MODEL=

# --- 9Router untuk TRANSKRIPSI (dipakai jika TRANSCRIBE_PROVIDER=ninerouter) ---
# TERPISAH dari NINEROUTER_* di atas (dipakai notulen) walau sama-sama 9Router - lihat
# komentar TRANSCRIBE_PROVIDER=ninerouter di atas kenapa dipisah.
NINEROUTER_TRANSCRIBE_URL=
NINEROUTER_TRANSCRIBE_API_KEY=
# Format WAJIB "provider/model", mis. "openai/whisper-1" atau "groq/whisper-large-v3" - cek
# pilihan lewat GET <NINEROUTER_TRANSCRIBE_URL>/v1/models/stt (BUKAN /v1/models biasa).
NINEROUTER_TRANSCRIBE_MODEL=

# --- Whisper (Speech-to-Text lokal, mendukung Bahasa Indonesia) ---
# Rekomendasi: "whisper-ctranslate2" (ringan & cepat, tanpa PyTorch, cocok untuk Apple Silicon)
#   pip3 install -U whisper-ctranslate2
# Alternatif: "whisper" (openai-whisper asli, lebih berat)
WHISPER_BIN=whisper-ctranslate2
# Model: small (cepat) / medium (lebih cepat, cukup akurat) / large-v3 (DEFAULT, paling akurat
#   tapi ~4x lebih lambat dari medium - lihat perbandingan nyata di SETUP.md bagian Performa)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=id
# Optimasi untuk meeting panjang (2+ jam) - hanya berlaku untuk whisper-ctranslate2:
# batched: percepat 2-4x pemrosesan; batch_size: makin besar makin cepat tapi makin banyak RAM
# (kecilkan ke 4 kalau RAM terbatas/<=8GB). vad_filter: skip bagian hening -> lebih cepat & akurat.
WHISPER_BATCHED=true
WHISPER_BATCH_SIZE=8
WHISPER_VAD_FILTER=true
# Whisper akurat untuk kalimat umum, tapi sering salah untuk nama tokoh/istilah asing/Arab
# (mis. nama ulama, judul kitab) - isi daftar istilah yang sering muncul di konten kamu untuk
# bantu Whisper mengenalinya. Contoh: "Taqiyuddin an-Nabhani, Al-Khaliq, khilafah, kaffah"
WHISPER_HOTWORDS=
# Opsional: contoh gaya bahasa/istilah di awal audio untuk bias model ke domain tertentu
WHISPER_INITIAL_PROMPT=
# Model KHUSUS dipakai kalau Whisper berperan sebagai FALLBACK (TRANSCRIBE_FALLBACK_PROVIDER=
# whisper) - kosongkan untuk pakai model yang sama dengan WHISPER_MODEL di atas. Berguna kalau
# primary-nya cloud (Gemini/OpenAI) dan mau fallback pakai model lebih kecil/cepat (mis.
# "medium") daripada model utama yang lebih besar (mis. "large-v3").
WHISPER_FALLBACK_MODEL=

# --- Perekaman Audio (ffmpeg) ---
# Jalankan `meetresult devices` untuk melihat daftar index device di sistemmu

# Mode "dual" (DEFAULT, direkomendasikan): rekam 2 device terpisah (mic asli + BlackHole)
#   lalu digabung otomatis. WAJIB dipakai jika aplikasi meeting (mis. Microsoft Teams) TIDAK BISA
#   memakai Aggregate Device sebagai Microphone (limitasi umum banyak app conferencing).
# Mode "single": rekam dari 1 device saja (perilaku lama, cukup kalau Aggregate Device
#   berhasil dipakai langsung sebagai Mic di app meeting kamu).
RECORD_MODE=dual

# --- Dipakai jika RECORD_MODE=dual ---
# FFMPEG_MIC_DEVICE_INDEX: mic ASLI kamu langsung (BUKAN aggregate) - AirPods/EarPods/built-in mic.
#   Device ini juga yang di-set sebagai Microphone di aplikasi meeting (mis. Teams).
FFMPEG_MIC_DEVICE_INDEX=":0"
# FFMPEG_SYSTEM_DEVICE_INDEX: BlackHole 2ch - menangkap suara lawan bicara (via Output/
#   Multi-Output Device yang di-set sebagai Speaker di aplikasi meeting).
FFMPEG_SYSTEM_DEVICE_INDEX=":0"

# --- Dipakai jika RECORD_MODE=single ---
FFMPEG_AUDIO_DEVICE_INDEX=":0"

RECORDING_SAMPLE_RATE=16000

# --- Watcher ---
# Interval polling kalender Outlook (menit)
WATCH_INTERVAL_MINUTES=2
# Buffer sebelum jadwal mulai untuk mulai merekam (menit)
RECORD_LEAD_MINUTES=1
# Kalau jadwal kalender sudah selesai TAPI Microsoft Teams masih berjalan (meeting molor dari
# jadwal), rekaman TIDAK langsung dipotong - diperpanjang & dicek ulang tiap N menit sampai
# Teams ditutup, maksimal M menit di atas jadwal selesai (jaring pengaman kalau lupa nutup
# Teams / meeting jadi sangat panjang).
MAX_MEETING_OVERTIME_MINUTES=120
MEETING_OVERTIME_CHECK_INTERVAL_MINUTES=3

# --- Deteksi meeting aktif (mencegah auto-record hal yang bukan meeting) ---
# Kalau event kalender ada tapi meeting-nya di-cancel/reschedule (tanpa update kalender),
# auto-record TETAP akan merekam apapun yang terjadi di dekat mic kalau tidak dicegah.
# Cek apakah Microsoft Teams sedang berjalan SEBELUM mulai auto-record. "false" untuk nonaktifkan.
REQUIRE_TEAMS_RUNNING=true
# Menit setelah mulai rekam untuk cek ULANG: kalau Teams TIDAK berjalan DAN channel audio
# system (BlackHole) diam total sejak mulai - rekaman dihentikan otomatis & TIDAK diproses
# (skip transkrip+notulen). Set ke 0 untuk nonaktifkan cek ini.
SILENCE_CHECK_AFTER_MINUTES=5
# Ambang batas dianggap "diam" dalam dBFS (makin negatif = makin sensitif)
SILENCE_THRESHOLD_DB=-50

# --- Retensi File Audio ---
# Hapus otomatis file rekaman audio setelah sekian hari (transkrip & notulen TETAP disimpan)
AUDIO_RETENTION_DAYS=3

# --- Dokumen MoM (Minutes of Meeting) ---
MOM_PREPARED_BY=MeetResult (Auto-generated by AI)
MOM_ORG_NAME=
# Skema MoM: "structured" (tabel Pembahasan+Action Items) atau
# "meeting_minutes" (narasi Resume bernomor + tabel Attendances, gaya formal/audit)
MOM_TEMPLATE_TYPE=structured
# Path template .docx yang dipakai untuk generate MoM (relatif terhadap folder project)
# Kosongkan untuk pakai default sesuai MOM_TEMPLATE_TYPE. Ganti untuk pakai desain/template baru
# TANPA ubah kode. Lihat README "Cara pakai TEMPLATE BARU".
MOM_TEMPLATE_PATH=
# Kirim ulang JSON notulen ke AI untuk perbaikan bahasa (lebih profesional/padat/rapi, kata
# pengisi & pengulangan dari transkripsi lisan dihilangkan) sebelum dirender ke .docx - TANPA
# mengubah struktur atau menghilangkan informasi (jumlah item per tabel/list dijaga sama).
# Nambah 1x panggilan AI lagi (waktu & biaya) tiap notulen dibuat. "false" untuk nonaktifkan.
MOM_POLISH_LANGUAGE=true

# --- Pencegah tidur saat merekam (macOS) ---
# true (default): Mac ditahan tidak tidur selama ffmpeg merekam (caffeinate, otomatis lepas
# begitu rekaman selesai). Tidak bisa mencegah tidur karena laptop DITUTUP (lid).
PREVENT_SLEEP_WHILE_RECORDING=true
