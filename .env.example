# ==========================================================
# MEETRESULT CONFIGURATION
# Copy this file to ".env" and fill in your credentials.
# (The installed app does this for you on first launch; edit
#  the values in the Settings window or in this file.)
# ==========================================================

# --- Calendar mode ---
# "ics"   (default, EASIEST): just the publish URL of your Outlook Web calendar,
#          no Azure app / OAuth login needed. See SETUP.md "Calendar Setup".
# "graph" : uses the Microsoft Graph API (needs an Azure App Registration + `meetresult login`),
#          more real time and more complete data (the join URL is always accurate).
CALENDAR_MODE=ics

# --- ICS mode (used when CALENDAR_MODE=ics) ---
# Get it from: Outlook Web > Settings > Calendar > Shared calendars
#   > Publish a calendar > choose "Can view all details" > copy the "ICS" link
CALENDAR_ICS_URL=

# --- Graph mode / Microsoft Azure AD app (used when CALENDAR_MODE=graph) ---
# Create it at https://portal.azure.com > Azure Active Directory > App registrations
# Redirect: use the "Device Code Flow", no web redirect URI needed
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# --- AI provider for writing the minutes (transcript text -> MoM JSON) ---
# "claude" (DEFAULT): uses Claude, see the CLAUDE_* settings below.
# "openai": an OpenAI-compatible Chat Completions endpoint (OPENAI_*) - either OpenAI cloud
#   OR a LOCAL server (oMLX/Ollama/LM Studio) via OPENAI_BASE_URL. If `npm install` detects one
#   of those local servers running, this line is set to "openai" automatically - run
#   `meetresult setup-ai` any time to re-detect manually.
# "agy": uses the Antigravity CLI, see AGY_* below.
# "opencode": uses the OpenCode CLI, see OPENCODE_* below - MINUTES ONLY, not for transcription.
# "ninerouter": uses the 9Router gateway (https://github.com/decolua/9router, local/remote,
#   OpenAI-compatible) via /v1/chat/completions - see NINEROUTER_* below.
SUMMARY_PROVIDER=claude
# BACKUP provider used when the main one above fails (technical error, exhausted quota, an
# empty or invalid response, ...) - leave empty to disable. Pick one of:
# claude / openai / agy / opencode / ninerouter (different from the main provider).
SUMMARY_FALLBACK_PROVIDER=

# --- Claude (used when SUMMARY_PROVIDER=claude) ---
# "cli" mode (DEFAULT, recommended): uses the Claude Code CLI already logged in with your
#   account/subscription (`claude login`), with NO separate API key.
# "api" mode: uses the Anthropic API directly, needs ANTHROPIC_API_KEY (billed per token).
CLAUDE_MODE=cli
CLAUDE_CLI_BIN=claude
# Optional: force a specific model in the Claude Code CLI (leave empty for the default).
# Aliases "opus" / "sonnet" / "haiku" always point at the newest model of that family.
CLAUDE_CLI_MODEL=

# --- (Only when CLAUDE_MODE=api) Anthropic API key ---
# Get it at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI-compatible (used when SUMMARY_PROVIDER=openai) ---
# OPENAI_BASE_URL: defaults to OpenAI cloud. To use a LOCAL model, point it at a local
#   OpenAI-compatible server, for example:
#   oMLX (Apple Silicon): http://127.0.0.1:8000/v1  (port & API key are in ~/.omlx/settings.json)
#   Ollama              : http://localhost:11434/v1
#   LM Studio           : http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Leave empty if the local server needs no authentication (common for Ollama/LM Studio; oMLX REQUIRES it)
OPENAI_API_KEY=
# Fill in the model name used by your provider/server
OPENAI_MODEL=gpt-4o-mini

# --- Antigravity CLI / Gemini (used when SUMMARY_PROVIDER=agy) ---
# Uses the Antigravity CLI (Google, Gemini models) installed and logged in on this machine
# - https://antigravity.google - with NO separate API key. Like CLAUDE_MODE=cli, this shells
# out to the official binary that you installed and logged in yourself.
AGY_CLI_BIN=agy
# Leave empty to use the default model of the logged-in agy session. List the models with
# `agy models` in a terminal (or `meetresult models` after SUMMARY_PROVIDER=agy).
AGY_MODEL=

# --- OpenCode CLI (used when SUMMARY_PROVIDER=opencode) - MINUTES ONLY, not transcription ---
# Uses the OpenCode CLI (https://opencode.ai) installed and logged in yourself on this machine
# ('opencode providers login') - many models (Claude/GPT/Gemini/...) through OpenCode
# Zen/Go. DELIBERATELY used for minutes (text) only - audio attachments do not work in the
# opencode CLI, and once they fail the model tries to run shell commands on its own to find
# another way (agentic behaviour that is unsafe for automatic transcription).
OPENCODE_CLI_BIN=opencode
# The format MUST be "provider/model", e.g. "opencode/gemini-3.7-flash" or "opencode-go/kimi-k3" -
# list the options with `opencode models` in a terminal. Leave empty for opencode's default.
OPENCODE_MODEL=

# --- 9Router for MINUTES (used when SUMMARY_PROVIDER=ninerouter) ---
# https://github.com/decolua/9router - a local/remote OpenAI-compatible gateway for many AI
# providers at once (one key, many providers, automatic fallback). DELIBERATELY SEPARATE from
# NINEROUTER_TRANSCRIBE_* below (used by TRANSCRIBE_PROVIDER=ninerouter) even though both are
# 9Router - 9Router itself has SEPARATE model lists for chat (/v1/models) and
# speech-to-text (/v1/models/stt), so the two roles are fully separated here too.
NINEROUTER_URL=
# May stay empty if the 9Router instance does not enable requireApiKey.
NINEROUTER_API_KEY=
# The format MUST be "provider/model", e.g. "openai/gpt-5" or "cc/claude-opus-4-7" - list the
# options with GET <NINEROUTER_URL>/v1/models.
NINEROUTER_MODEL=

# --- Audio -> text transcription provider ---
# "whisper" (DEFAULT): local, offline, free - see the WHISPER_* settings below. The model is
#   downloaded automatically the first time it is used (or via the "Unduh" button in the menu bar app).
# "gemini": sends audio to the Gemini API (needs internet + GEMINI_API_KEY) - Gemini natively
#   understands audio, PROVEN the most accurate for specialised terms/names (see the SETUP.md
#   Performance section), but your meeting audio is sent to Google's servers.
# "openai": sends audio to the OFFICIAL OpenAI Audio Transcriptions API (needs internet +
#   OPENAI_TRANSCRIBE_API_KEY) - your meeting audio is sent to OpenAI's servers.
# "openai-compatible": your OWN custom/local server that is compatible with the OpenAI Audio
#   Transcriptions API shape (POST /audio/transcriptions) - SEPARATE from "openai" above so
#   the configurations never get mixed up. See OPENAI_COMPATIBLE_TRANSCRIBE_* below.
# "ninerouter": uses the 9Router gateway via /v1/audio/transcriptions - the model MUST come from
#   the SPEECH-TO-TEXT list /v1/models/stt (NOT the ordinary chat model list). See
#   NINEROUTER_TRANSCRIBE_* below - SEPARATE from NINEROUTER_* for minutes above.
TRANSCRIBE_PROVIDER=whisper
# BACKUP provider used when the main one above fails (technical error, exhausted quota, ...) -
# leave empty to disable. Recommendation: set "whisper" when the main provider is cloud
# (gemini/openai), so transcription STILL succeeds even if the cloud is down or out of quota.
TRANSCRIBE_FALLBACK_PROVIDER=

# --- Gemini API (used when TRANSCRIBE_PROVIDER=gemini) ---
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MUST be filled in manually - check the LATEST audio-capable model name in Google AI Studio
# (Gemini model names change over time, so there is deliberately no hard-coded default)
GEMINI_MODEL=
# Gemini has a per-minute request limit (some free/paid tiers are capped at 15 requests/minute) -
# when transcription hits the limit, it retries after this pause (not an aggressive tight
# retry loop) before finally giving up to TRANSCRIBE_FALLBACK_PROVIDER.
GEMINI_TRANSCRIBE_MAX_RETRIES=3
GEMINI_TRANSCRIBE_RETRY_DELAY_MS=60000

# --- OFFICIAL OpenAI Audio Transcriptions (used when TRANSCRIBE_PROVIDER=openai) ---
# DELIBERATELY separate from OPENAI_API_KEY/OPENAI_BASE_URL above (which are used for MINUTES
# via SUMMARY_PROVIDER=openai) - the minutes base URL is often pointed at a LOCAL server (oMLX/
# Ollama/LM Studio) that usually has no audio endpoint, whereas audio transcription almost
# always needs the real OpenAI cloud. Get an API key at https://platform.openai.com/api-keys
OPENAI_TRANSCRIBE_API_KEY=
# Leave it to use the real OpenAI cloud server (default) - rarely needs changing
OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# "gpt-4o-transcribe" (DEFAULT, better accuracy) / "gpt-4o-mini-transcribe" (faster &
# cheaper) / "whisper-1" (OpenAI's older model, cheaper)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Custom OpenAI-compatible (used when TRANSCRIBE_PROVIDER=openai-compatible) ---
# SEPARATE from OPENAI_TRANSCRIBE_* above (OFFICIAL OpenAI cloud) - for your own
# CUSTOM/LOCAL transcription server that is merely COMPATIBLE with the API shape (POST
# /audio/transcriptions), so the two configurations never get mixed up. There is no
# default base URL - it MUST be filled in manually, e.g. http://localhost:8000/v1
OPENAI_COMPATIBLE_TRANSCRIBE_BASE_URL=
# May stay empty if the custom server needs no authentication.
OPENAI_COMPATIBLE_TRANSCRIBE_API_KEY=
# Fill in the model ID your custom server provides (may stay empty if the server has only
# one model and ignores this parameter).
OPENAI_COMPATIBLE_TRANSCRIBE_MODEL=

# --- 9Router for TRANSCRIPTION (used when TRANSCRIBE_PROVIDER=ninerouter) ---
# SEPARATE from NINEROUTER_* above (used for minutes) even though both are 9Router - see the
# TRANSCRIBE_PROVIDER=ninerouter comment above for why they are separate.
NINEROUTER_TRANSCRIBE_URL=
NINEROUTER_TRANSCRIBE_API_KEY=
# The format MUST be "provider/model", e.g. "openai/whisper-1" or "groq/whisper-large-v3" - list
# the options with GET <NINEROUTER_TRANSCRIBE_URL>/v1/models/stt (NOT the ordinary /v1/models).
NINEROUTER_TRANSCRIBE_MODEL=

# --- Whisper (local Speech-to-Text, supports Bahasa Indonesia) ---
# Recommended: "whisper-ctranslate2" (lightweight & fast, no PyTorch, good for Apple Silicon)
#   pip3 install -U whisper-ctranslate2
# Alternative: "whisper" (the original openai-whisper, heavier)
WHISPER_BIN=whisper-ctranslate2
# Model: small (fast) / medium (faster, accurate enough) / large-v3 (DEFAULT, most accurate
#   but ~4x slower than medium - see the real comparison in the SETUP.md Performance section)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=id
# Optimisations for long meetings (2+ hours) - only apply to whisper-ctranslate2:
# batched: speeds processing up 2-4x; batch_size: bigger is faster but uses more RAM
# (lower it to 4 on limited RAM / <=8GB). vad_filter: skips silent parts -> faster & more accurate.
WHISPER_BATCHED=true
WHISPER_BATCH_SIZE=8
WHISPER_VAD_FILTER=true
# Whisper is accurate on general sentences but often wrong on personal names / foreign / Arabic
# terms (e.g. scholars' names, book titles) - list the terms that often appear in your content
# to help Whisper recognise them. Example: "Taqiyuddin an-Nabhani, Al-Khaliq, khilafah, kaffah"
WHISPER_HOTWORDS=
# Optional: a sample of the language style/terms at the start of the audio, to bias the model
# towards a specific domain
WHISPER_INITIAL_PROMPT=
# A DEDICATED model used when Whisper acts as the FALLBACK (TRANSCRIBE_FALLBACK_PROVIDER=
# whisper) - leave empty to use the same model as WHISPER_MODEL above. Useful when the
# primary is cloud (Gemini/OpenAI) and you want the fallback to use a smaller/faster model (e.g.
# "medium") than the larger main model (e.g. "large-v3").
WHISPER_FALLBACK_MODEL=

# --- Audio recording (ffmpeg) ---
# Run `meetresult devices` to see the device index list on your system

# "dual" mode (DEFAULT, recommended): records 2 separate devices (real mic + BlackHole)
#   and merges them automatically. REQUIRED if the meeting app (e.g. Microsoft Teams) CANNOT
#   use an Aggregate Device as a Microphone (a common limitation of many conferencing apps).
# "single" mode: records from one device only (the old behaviour, enough if an Aggregate
#   Device works directly as the Mic in your meeting app).
RECORD_MODE=dual

# --- Used when RECORD_MODE=dual ---
# FFMPEG_MIC_DEVICE_INDEX: your REAL mic directly (NOT an aggregate) - AirPods/EarPods/built-in mic.
#   This is also the device set as the Microphone in the meeting app (e.g. Teams).
FFMPEG_MIC_DEVICE_INDEX=":0"
# FFMPEG_SYSTEM_DEVICE_INDEX: BlackHole 2ch - captures the other participants' voices (via the
#   Output/Multi-Output Device set as the Speaker in the meeting app).
FFMPEG_SYSTEM_DEVICE_INDEX=":0"

# --- Used when RECORD_MODE=single ---
FFMPEG_AUDIO_DEVICE_INDEX=":0"

RECORDING_SAMPLE_RATE=16000

# --- Watcher ---
# Outlook calendar polling interval (minutes)
WATCH_INTERVAL_MINUTES=2
# Buffer before the scheduled start at which to begin recording (minutes)
RECORD_LEAD_MINUTES=1
# When the calendar slot has ended BUT Microsoft Teams is still running (the meeting overran its
# schedule), the recording is NOT cut right away - it is extended and re-checked every N
# minutes until Teams is closed, at most M minutes past the scheduled end (a safety net in case
# Teams is left open / the meeting becomes very long).
MAX_MEETING_OVERTIME_MINUTES=120
MEETING_OVERTIME_CHECK_INTERVAL_MINUTES=3

# --- Active meeting detection (prevents auto-recording things that are not meetings) ---
# If a calendar event exists but the meeting was cancelled/rescheduled (without a calendar
# update), auto-record WILL still record whatever happens near the mic unless prevented.
# Check whether Microsoft Teams is running BEFORE starting auto-record. "false" to disable.
REQUIRE_TEAMS_RUNNING=true
# Minutes after recording starts at which to RE-check: if Teams is NOT running AND the system
# audio channel (BlackHole) has been completely silent since the start - the recording is
# stopped automatically & NOT processed (transcript + minutes skipped). Set to 0 to disable this check.
SILENCE_CHECK_AFTER_MINUTES=5
# Threshold below which audio counts as "silent", in dBFS (the more negative, the more sensitive)
SILENCE_THRESHOLD_DB=-50

# --- Audio file retention ---
# Automatically delete recorded audio files after this many days (transcripts & minutes are KEPT)
AUDIO_RETENTION_DAYS=3

# --- MoM (Minutes of Meeting) document ---
MOM_PREPARED_BY=MeetResult (Auto-generated by AI)
MOM_ORG_NAME=
# MoM scheme: "structured" (Discussion + Action Items tables) or
# "meeting_minutes" (numbered narrative Resume + Attendances table, formal/audit style)
MOM_TEMPLATE_TYPE=structured
# Path of the .docx template used to generate the MoM (relative to the data/settings folder -
# the project folder, or ~/Library/Application Support/MeetResult for the installed app).
# Leave empty to use the default for MOM_TEMPLATE_TYPE. Change it to use a new design/template
# WITHOUT changing code. See SETUP.md "Using a NEW TEMPLATE".
MOM_TEMPLATE_PATH=
# Send the minutes JSON back to the AI to polish the wording (more professional/concise/tidy,
# filler words & repetitions from spoken transcription removed) before it is rendered to .docx -
# WITHOUT changing the structure or dropping information (the number of items per table/list is kept the same).
# Adds one more AI call (time & cost) every time minutes are generated. "false" to disable.
MOM_POLISH_LANGUAGE=true

# --- Keep the Mac awake while recording (macOS) ---
# true (default): the Mac is kept from sleeping while ffmpeg records (caffeinate, released
# automatically when the recording ends). Cannot prevent sleep caused by CLOSING the lid.
PREVENT_SLEEP_WHILE_RECORDING=true

# --- Minutes provider resilience ---
# TRANSIENT problems (network loss, busy server/503, empty response) are first retried this many
# times on the same provider after this pause, only then switching to the fallback. An expired
# login / exhausted quota is NOT retried. Set AI_TRANSIENT_RETRIES=0 to turn this off.
AI_TRANSIENT_RETRIES=1
AI_TRANSIENT_RETRY_DELAY_MS=30000
