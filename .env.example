# ==========================================================
# KONFIGURASI MEETRESULT
# Salin file ini menjadi ".env" lalu isi sesuai kredensial kamu
# ==========================================================

# --- Mode Kalender ---
# "ics"   (default, PALING MUDAH): cukup URL publish kalender dari Outlook Web,
#          tanpa perlu bikin Azure App / login OAuth. Lihat README "Setup Kalender (ICS)".
# "graph" : pakai Microsoft Graph API (butuh Azure App Registration + `meetresult login`),
#          lebih real-time & datanya lebih lengkap (joinUrl pasti akurat).
CALENDAR_MODE=ics

# --- Mode ICS (dipakai jika CALENDAR_MODE=ics) ---
# Dapatkan dari: Outlook Web > Settings > Calendar > Shared calendars
#   > Publish a calendar > pilih "Can view all details" > copy link "ICS"
CALENDAR_ICS_URL=

# --- Mode Graph / Microsoft Azure AD App (dipakai jika CALENDAR_MODE=graph) ---
# Buat di https://portal.azure.com > Azure Active Directory > App registrations
# Redirect: gunakan "Device Code Flow", tidak butuh redirect URI web
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# --- Claude (untuk membuat ringkasan / notulen MoM) ---
# Mode "cli" (DEFAULT, direkomendasikan): pakai Claude Code CLI yang sudah login
#   dengan akun/subscription kamu (`claude login`), TANPA API key terpisah.
# Mode "api": pakai Anthropic API langsung, butuh ANTHROPIC_API_KEY (dikenakan biaya per token).
CLAUDE_MODE=cli
CLAUDE_CLI_BIN=claude
# Opsional: paksa model tertentu di Claude Code CLI (kosongkan untuk pakai default)
CLAUDE_CLI_MODEL=

# --- (Hanya jika CLAUDE_MODE=api) Anthropic API key ---
# Dapatkan di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Whisper (Speech-to-Text lokal, mendukung Bahasa Indonesia) ---
# Rekomendasi: "whisper-ctranslate2" (ringan & cepat, tanpa PyTorch, cocok untuk Apple Silicon)
#   pip3 install -U whisper-ctranslate2
# Alternatif: "whisper" (openai-whisper asli, lebih berat)
WHISPER_BIN=whisper-ctranslate2
# Model: small (cepat) / medium (rekomendasi, akurat utk Bahasa Indonesia) / large-v3 (paling akurat, berat)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=id
# Optimasi untuk meeting panjang (2+ jam) - hanya berlaku untuk whisper-ctranslate2:
# batched: percepat 2-4x pemrosesan; batch_size: makin besar makin cepat tapi makin banyak RAM
# (kecilkan ke 4 kalau RAM terbatas/<=8GB). vad_filter: skip bagian hening -> lebih cepat & akurat.
WHISPER_BATCHED=true
WHISPER_BATCH_SIZE=8
WHISPER_VAD_FILTER=true

# --- Perekaman Audio (ffmpeg) ---
# Jalankan `meetresult devices` untuk melihat daftar index device di sistemmu

# Mode "dual" (DEFAULT, direkomendasikan): rekam 2 device terpisah (mic asli + BlackHole)
#   lalu digabung otomatis. WAJIB dipakai jika aplikasi meeting (mis. Microsoft Teams) TIDAK BISA
#   memakai Aggregate Device sebagai Microphone (limitasi umum banyak app conferencing).
# Mode "single": rekam dari 1 device saja (perilaku lama, cukup kalau Aggregate Device
#   berhasil dipakai langsung sebagai Mic di app meeting kamu).
RECORD_MODE=dual

# --- Dipakai jika RECORD_MODE=dual ---
# FFMPEG_MIC_DEVICE_INDEX: mic ASLI kamu langsung (BUKAN aggregate) - AirPods/EarPods/built-in mic.
#   Device ini juga yang di-set sebagai Microphone di aplikasi meeting (mis. Teams).
FFMPEG_MIC_DEVICE_INDEX=":0"
# FFMPEG_SYSTEM_DEVICE_INDEX: BlackHole 2ch - menangkap suara lawan bicara (via Output/
#   Multi-Output Device yang di-set sebagai Speaker di aplikasi meeting).
FFMPEG_SYSTEM_DEVICE_INDEX=":0"

# --- Dipakai jika RECORD_MODE=single ---
FFMPEG_AUDIO_DEVICE_INDEX=":0"

RECORDING_SAMPLE_RATE=16000

# --- Watcher ---
# Interval polling kalender Outlook (menit)
WATCH_INTERVAL_MINUTES=2
# Buffer sebelum jadwal mulai untuk mulai merekam (menit)
RECORD_LEAD_MINUTES=1

# --- Retensi File Audio ---
# Hapus otomatis file rekaman audio setelah sekian hari (transkrip & notulen TETAP disimpan)
AUDIO_RETENTION_DAYS=3

# --- Dokumen MoM (Minutes of Meeting) ---
MOM_PREPARED_BY=MeetResult (Auto-generated by AI)
MOM_ORG_NAME=
# Skema MoM: "structured" (tabel Pembahasan+Action Items) atau
# "meeting_minutes" (narasi Resume bernomor + tabel Attendances, gaya formal/audit)
MOM_TEMPLATE_TYPE=structured
# Path template .docx yang dipakai untuk generate MoM (relatif terhadap folder project)
# Kosongkan untuk pakai default sesuai MOM_TEMPLATE_TYPE. Ganti untuk pakai desain/template baru
# TANPA ubah kode. Lihat README "Cara pakai TEMPLATE BARU".
MOM_TEMPLATE_PATH=
